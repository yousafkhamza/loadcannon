{
  "name": "public-direct-ip-no-token-demo",
  "target": {
    "type": "public",
    "url": "https://1.1.1.1",
    "host_override": "one.one.one.one",
    "insecure_skip_verify": true
  },
  "auth": {
    "mode": "none"
  },
  "scenarios": [
    {
      "name": "cdn-trace",
      "method": "GET",
      "path": "/cdn-cgi/trace",
      "weight": 1,
      "expect_status": 200
    }
  ],
  "load": {
    "vus": 15,
    "duration": "30s"
  },
  "thresholds": {
    "http_req_duration": "p(95)<400",
    "http_req_failed": "rate<0.01"
  }
}
