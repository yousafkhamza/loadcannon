{
  "name": "internal-style-with-token-demo (stand-in: swap url for your real internal LB when ready)",
  "target": {
    "type": "internal",
    "url": "https://httpbin.org"
  },
  "auth": {
    "mode": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "token_source": "env",
    "token_ref": "DEMO_TOKEN"
  },
  "scenarios": [
    {
      "name": "bearer-check",
      "method": "GET",
      "path": "/bearer",
      "weight": 1,
      "expect_status": 200
    }
  ],
  "load": {
    "vus": 10,
    "duration": "20s"
  },
  "thresholds": {
    "http_req_duration": "p(95)<800",
    "http_req_failed": "rate<0.02"
  }
}
