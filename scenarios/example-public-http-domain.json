{
  "name": "public-http-no-token-demo",
  "target": {
    "type": "public",
    "url": "http://httpbin.org"
  },
  "auth": {
    "mode": "none"
  },
  "scenarios": [
    {
      "name": "get",
      "method": "GET",
      "path": "/get",
      "weight": 1,
      "expect_status": 200
    }
  ],
  "load": {
    "vus": 10,
    "duration": "20s"
  },
  "thresholds": {
    "http_req_duration": "p(95)<800",
    "http_req_failed": "rate<0.02"
  }
}
